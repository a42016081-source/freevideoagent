# Copy to .env for LOCAL use. On GitHub, put these in Settings -> Secrets and variables -> Actions.
# Never commit your real .env (it is in .gitignore).

# ---- Required ----
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (get yours from @userinfobot).
# EMPTY = NOBODY is allowed (the bot fails closed).
ALLOWED_USER_IDS=

# ---- Optional: NVIDIA (free credits at build.nvidia.com -> "Get API Key", key looks like nvapi-...) ----
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Optional: any OpenAI-compatible LLM (OpenRouter, Groq, Together, OpenAI ...) ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Optional: better voice ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Optional: real stock footage / photos ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Local-only: GitHub dispatch (on Actions these are set automatically) ----
# GITHUB_TOKEN=      # a PAT with "Actions: read & write" on this repo
# GITHUB_REPO=owner/repo

# ---- Optional: permanent memory in Cloudflare D1 (settings, notes, job history, installed skills) ----
# All three needed. Token permission: Account -> D1 -> Edit (nothing else).
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ---- Runtime ----
LOG_LEVEL=INFO
# RENDER_OFFLINE=1   # never touch the network (dry-run mode)
# LLM_ORDER=nvidia,pollinations
# IMAGE_ORDER=nvidia,pollinations

# Web chat (see web/README.md): where the bot sends answers for the browser, and the shared secret
WEB_BASE_URL=
BRIDGE_SECRET=
